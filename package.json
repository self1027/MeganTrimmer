{
  "name": "megantrimmer",
  "version": "1.2.2",
  "description": "Editor de vídeo leve para cortes rápidos com aceleração por hardware.",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "icons": "node scripts/generate-icons.cjs",
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && cpy \"src/renderer/**/*\" dist/renderer && cpy \"src/assets/**/*\" dist/assets",
    "dev": "npm run build && electron .",
    "test": "npm run build && node --test dist/main/services/*.test.js dist/shared/*.test.js",
    "test:ui": "npm run build && electron scripts/smoke.cjs",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:msi": "npm run build && electron-builder --win nsis --win msiwrapped"
  },
  "build": {
    "appId": "com.megan.megantrimmer",
    "productName": "MeganTrimmer",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/ffmpeg.exe",
      "**/node_modules/ffprobe-static/bin/win32/x64/ffprobe.exe"
    ],
    "files": [
      "dist/**/*",
      "!dist/**/*.test.js",
      "!dist/**/*.map",
      "src/assets/**/*",
      "package.json",
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "node_modules/ffprobe-static/index.js",
      "node_modules/ffprobe-static/package.json",
      "node_modules/ffprobe-static/bin/win32/x64/ffprobe.exe",
      "!node_modules/ffprobe-static/bin/darwin/**/*",
      "!node_modules/ffprobe-static/bin/linux/**/*",
      "!node_modules/ffprobe-static/bin/win32/ia32/**/*",
      "node_modules/fluent-ffmpeg/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msiwrapped",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MeganTrimmer",
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "msiWrapped": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "upgradeCode": "{8A3F2B1C-4D5E-6F7A-8B9C-0D1E2F3A4B5C}"
    },
    "mac": {
      "icon": "src/assets/logo.png",
      "target": "dmg"
    },
    "linux": {
      "icon": "src/assets/logo.png",
      "target": "AppImage"
    }
  },
  "keywords": [
    "video",
    "editor",
    "ffmpeg",
    "electron",
    "trim"
  ],
  "author": "Murilo D. <https://murilod.dev/>",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "6.8.12",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^25.6.0",
    "@types/semver": "7.7.1",
    "cpy-cli": "^7.0.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.2"
  },
  "allowScripts": {
    "electron@41.10.7": true,
    "electron-winstaller@5.4.0": true,
    "ffmpeg-static@5.3.0": true
  }
}
