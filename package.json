{
  "name": "megantrimmer",
  "version": "1.2.0",
  "description": "Editor de vídeo leve para cortes rápidos com aceleração por hardware.",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && cpy \"src/renderer/**/*\" dist/renderer && cpy \"src/assets/**/*\" dist/assets",
    "dev": "npm run build && electron .",
    "test": "npm run build && node --test dist/main/services/output-path.test.js dist/main/services/settings.test.js",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:msi": "npm run build && electron-builder --win nsis --win msiwrapped"
  },
  "build": {
    "appId": "com.megan.megantrimmer",
    "productName": "MeganTrimmer",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/ffmpeg.exe"
    ],
    "files": [
      "dist/**/*",
      "!dist/**/*.test.js",
      "!dist/**/*.map",
      "src/assets/**/*",
      "package.json",
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "node_modules/fluent-ffmpeg/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] },
        { "target": "msiwrapped", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MeganTrimmer",
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "msiWrapped": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "upgradeCode": "{8A3F2B1C-4D5E-6F7A-8B9C-0D1E2F3A4B5C}"
    },
    "mac": {
      "icon": "assets/logo.png",
      "target": "dmg"
    },
    "linux": {
      "icon": "assets/logo.png",
      "target": "AppImage"
    }
  },
  "keywords": [
    "video",
    "editor",
    "ffmpeg",
    "electron",
    "trim"
  ],
  "author": "Murilo D. <https://murilod.dev/>",
  "license": "ISC",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^25.6.0",
    "cpy-cli": "^7.0.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.2"
  },
  "allowScripts": {
    "electron@41.10.7": true,
    "electron-winstaller@5.4.0": true,
    "ffmpeg-static@5.3.0": true
  }
}
