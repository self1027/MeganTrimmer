{
  "name": "nobstrimmer",
  "version": "1.1.0",
  "description": "No BS Trimmer – Simple, no‑bloat video trimming tool",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
      "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && cpy \"src/renderer/**/*\" dist/renderer && cpy \"src/assets/**/*\" dist/assets",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.nobstrimmer.app",
    "productName": "NoBSTrimmer",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/ffmpeg.exe"
    ],
    "files": [
      "dist/**/*",
      "src/assets/**/*",
      "package.json",
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "node_modules/fluent-ffmpeg/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "assets/logo.ico",
      "artifactName": "${productName}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "icon": "assets/logo.png",
      "target": "dmg"
    },
    "linux": {
      "icon": "assets/logo.png",
      "target": "AppImage"
    }
  },
  "keywords": [],
  "author": "Murilo D.",
  "license": "ISC",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^25.6.0",
    "cpy-cli": "^7.0.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.2"
  }
}