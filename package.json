{
  "name": "video-trimmer",
  "version": "1.0.0",
  "description": "Video Trimmer by self1027",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && cpy \"src/renderer/**/*\" dist/renderer",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.video.trimmer",
    "productName": "VideoTrimmer",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/ffmpeg.exe"
    ],
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "node_modules/fluent-ffmpeg/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "artifactName": "${productName}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    }
  },
  "keywords": [],
  "author": "Murilo D.",
  "license": "ISC",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^25.6.0",
    "cpy-cli": "^7.0.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.2"
  }
}